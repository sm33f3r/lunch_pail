# reporter/.env.example
# Copy to reporter/.env and fill in values before running.

# ---------------------------------------------------------------------------
# API base URLs
# These have working defaults — override only for testing or staging.
# ---------------------------------------------------------------------------
# GAMMA_API_BASE_URL=https://gamma-api.polymarket.com
# DATA_API_BASE_URL=https://data-api.polymarket.com
# CLOB_API_BASE_URL=https://clob.polymarket.com

# ---------------------------------------------------------------------------
# Trading-relevant settings — REQUIRED, no defaults.
# ---------------------------------------------------------------------------

# Minimum volume (in USD) a market must have in the configured window
# before it is included in the report.
VOLUME_THRESHOLD=

# Time window for volume measurement.
# Must be one of: 24hr | 1wk | 1mo | 1yr | lifetime
VOLUME_WINDOW=

# Directory where generated reports are written.
# Created automatically if it does not exist.
REPORT_OUTPUT_DIR=

# How often (in seconds) the watcher polls for new market data.
POLLING_INTERVAL_SECONDS=
